# Copy to .env.local for `npm run dev`, or export as build args for Docker.
#
# NEXT_PUBLIC_* values are inlined into the JS bundle at BUILD time (Next.js
# behaviour) — changing them requires a rebuild, not just a restart.

# Base URL of the Go backend REST API (no trailing slash).
# Leave EMPTY to use the browser's own origin — the right choice on a VPS
# where nginx reverse-proxies /api/v1 and /ws to the backend container.
NEXT_PUBLIC_API_URL=http://localhost:8080

# WebSocket base URL. Usually left empty: it is derived from
# NEXT_PUBLIC_API_URL by swapping http(s):// for ws(s)://.
# NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Port for `next start` / the Docker container (runtime, not build time).
# PORT=3000
