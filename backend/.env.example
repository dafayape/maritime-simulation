# Copy to .env and adjust. Every value has a sane default for local
# docker-compose; on a VPS change at least POSTGRES_PASSWORD.

# --- HTTP ---
HTTP_PORT=8080
# HTTP_ADDR=:8080
# PPROF_ADDR=127.0.0.1:6060     # profiler; keep empty/localhost in production
# CORS_ALLOWED_ORIGINS=*        # comma-separated dashboard origins in production

# --- logging ---
LOG_LEVEL=info                  # debug | info | warn | error

# --- PostgreSQL ---
POSTGRES_USER=simulator
POSTGRES_PASSWORD=simulator
POSTGRES_DB=lora_simulator
# POSTGRES_HOST=localhost       # ignored by docker-compose (service name wins)
# POSTGRES_PORT=5432
# POSTGRES_DSN=postgres://user:pass@host:5432/db?sslmode=disable   # overrides the parts above

# --- Redis ---
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# --- simulation tuning ---
TOPOLOGY_INTERVAL_SECONDS=5     # mesh recompute cadence (SRS: 5 s)
PING_MIN_INTERVAL_SECONDS=3     # GPS write rate limit per node (PRD: 3 s)
# WORKER_POOL_SIZE=0            # 0 = auto (4 × CPU cores)
# WS_SEND_BUFFER=256
# SHUTDOWN_TIMEOUT_SECONDS=10
